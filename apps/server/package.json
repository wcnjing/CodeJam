{
  "name": "@sentinel/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "eval:policy": "tsx src/policy-eval-cli.ts",
    "threat-model": "tsx src/threat-model-cli.ts",
    "bench:security": "tsx src/security-benchmark-cli.ts",
    "bench:store": "tsx src/bench/store-overhead-cli.ts",
    "bench": "tsx src/bench/bench-cli.ts",
    "bench:overhead": "tsx src/bench/overhead-cli.ts",
    "bench:generate": "tsx src/bench/generate-cli.ts",
    "redteam": "tsx src/redteam-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@sentinel/evaluation": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
