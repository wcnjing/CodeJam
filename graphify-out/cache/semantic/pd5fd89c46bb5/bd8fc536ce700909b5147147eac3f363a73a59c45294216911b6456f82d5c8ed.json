{"nodes": [{"id": "readme_sentinel", "label": "Sentinel", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_kill_switch_track", "label": "Kill Switch Track (Selected)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_command_policy_engine", "label": "Command Policy Engine", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layered as shell-parse.ts -> capabilities.ts -> command-policy.ts so a rule is a statement about capabilities (e.g. an actor holding SECRET_READ may not also exercise NETWORK_EGRESS) rather than a pattern over shell syntax, so many command spellings collapse into one rule, evidence reports what was attempted rather than which regex matched, and the same rules can later govern non-shell actions like an MCP tool call or database write."}, {"id": "readme_capability_model", "label": "Capability Model (NETWORK_EGRESS / SECRET_READ)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_human_approval", "label": "Human Approval (Held Runs)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_run_scoped_host_grant", "label": "Run-Scoped Host Grant", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_step_budget", "label": "Step Budget (POLICY_MAX_COMMANDS)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_monitor_mode", "label": "Monitor Mode (POLICY_ENFORCEMENT=monitor)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_redaction", "label": "Evidence Redaction", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_credential_boundary", "label": "Credential Boundary (ARK_API_KEY exclusion)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated Codex configuration keeps ARK_API_KEY available to the model provider but excludes it from spawned shell commands, and Codex's default KEY/SECRET/TOKEN exclusions remain enabled, so generic env/process.env/os.environ inspection stays usable without disclosing credentials; explicit Ark-key dereferences and /proc/.../environ reads are separately denied as defense in depth."}, {"id": "readme_policy_predicted_escape_rate", "label": "Policy-Predicted Escape Rate", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_security_evaluation_dashboard", "label": "Security Evaluation Dashboard", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_limitations", "label": "Sentinel Known Limitations", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detection is textual so a fully base64-encoded command defeats it; containment is a race against a fast single command completing before teardown, not a guarantee zero bytes leave; the guard is a reactive command-text check, not a network allowlist, so implicit destinations (bare npm install, git push to a preconfigured remote) pass; and policy state lives in a single-writer JSON store with no retention bound. Recorded honestly because each is a real gap."}, {"id": "readme_reproducing_demo", "label": "Reproducing the Demo (Scenario Walkthrough)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_configuration_table", "label": "Configuration Variables", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_how_it_works", "label": "How It Works (Runtime Flow)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_validation", "label": "Validation Commands", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_sentinel", "target": "docs_threat_model_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_sentinel", "target": "docs_policy_evaluation_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_sentinel", "target": "docs_operational_governance_coverage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_sentinel", "target": "doc