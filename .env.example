# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Named approver credentials: comma-separated id:token pairs. The id is what an
# approval records as its approver, so give each person their own token and use
# 24+ random characters whenever the server listens beyond loopback. Unlock the
# browser with the token of the person deciding.
# Required here: `docker compose up` runs a production server on 0.0.0.0 and
# refuses to start without at least one principal. Only a `npm run dev` server
# bound to loopback may leave this empty, and there the API is open but nothing
# can be approved.
APP_PRINCIPALS=

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Command policy (Kill Switch middleware). Enforcement destroys the Runtime
# container on the first denied command; monitor records the decision without
# terminating, which is what makes the before/after demo possible.
POLICY_ENFORCEMENT=enforce
# Runaway-execution control: max shell commands one run may execute before the
# platform kills it. Always enforced, independent of POLICY_ENFORCEMENT.
POLICY_MAX_COMMANDS=50
# Extra hosts the command guard treats as allowed, comma separated. The Ark host
# and loopback are always allowed. This config baseline is read-only in the UI;
# add/remove further hosts from the web Allowlist panel (or by approving a held
# command with "add to the allowlist") — those store-backed overrides survive
# restarts. With CONTAINER_EGRESS_ISOLATION=true these hosts are also the ones
# the egress broker permits, so they are reachable from the Agent container, not
# just policy-allowed. NOTE: the command guard itself is not a
# network allowlist — it denies commands that NAME a non-allowlisted destination,
# but a command with an implicit destination (bare `npm install`, `git push` to a
# preconfigured remote) is not blocked by it.
POLICY_ALLOWED_HOSTS=
# How long policyEvents/approvals survive in the store before being pruned
# (TM-OPS-001). A still-pending approval is exempt regardless of age.
AUDIT_RETENTION_DAYS=90

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep curl
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
# --- docker-compose.poc.yml only (not read by the server) ---
# The POC-as-Compose control plane container needs the host docker group to
# read /var/run/docker.sock, and runs as the host user so the spawned Agent
# containers can write their workspace mounts.
#   export DOCKER_GID=$(getent group docker | cut -d: -f3)
#   export POC_UID=$(id -u) POC_GID=$(id -g) CONTAINER_USER="$(id -u):$(id -g)"
# POC_ROOT is where the Compose POC keeps data/, workspaces/, codex-home/
# (default: $PWD/.poc-data).

# Runtime container hardening. See docs/EGRESS_CONTAINMENT.md.
# Read-only container root plus a noexec /tmp. The workspace and CODEX_HOME are
# bind mounts and stay writable, so the Agent is unaffected.
CONTAINER_READ_ONLY_ROOT=true
# Per-run isolated network + broker sidecar: the Agent gets no route out and
# reaches exactly one allowlisted endpoint. Needs the broker image
# (`npm run build:broker`); verify with `npm run verify:egress`.
CONTAINER_EGRESS_ISOLATION=true
# Explicit nameservers for the broker (the resolvers its DNS forwarder relays
# to) and for the Agent in bridge mode, comma separated. Empty inherits the
# engine's resolver. Needed when the host resolver is unreachable from
# containers (WSL NAT/VPN). On the isolated --internal network the Agent's own
# --dns is always the broker, which answers DNS for the Agent network on
# EGRESS_DNS_PORT (default 53).
# CONTAINER_DNS=1.1.1.1,8.8.8.8
