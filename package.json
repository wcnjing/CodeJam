{
  "name": "volc-agent-sentinel",
  "version": "1.0.0",
  "private": true,
  "description": "A middleware-free Agent platform starter kit running Codex CLI locally or on Volcengine ECS.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "tests"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @sentinel/server\" \"npm run dev -w @sentinel/web\"",
    "prepare": "npm run build -w @sentinel/evaluation",
    "build": "npm run build -w @sentinel/evaluation && npm run build -w @sentinel/web && npm run build -w @sentinel/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @sentinel/server && npm run test -w @sentinel/web && npm run test -w @sentinel/evaluation",
    "check": "npm run typecheck && npm run test && npm run build",
    "poc": "./scripts/start-local-poc.sh",
    "start": "npm run start -w @sentinel/server",
    "doctor": "node scripts/preflight.mjs",
    "preflight": "node scripts/preflight.mjs",
    "demo:offline": "node scripts/demo-offline.mjs",
    "demo:check": "node scripts/demo-smoke.mjs",
    "demo:check:replay": "node scripts/demo-smoke.mjs --self-host --skip-engine",
    "eval:policy": "npm run eval:policy -w @sentinel/server",
    "threat-model": "npm run threat-model -w @sentinel/server",
    "bench:security": "npm run bench:security -w @sentinel/server",
    "bench:store": "npm run bench:store -w @sentinel/server",
    "bench": "npm run bench -w @sentinel/server",
    "bench:overhead": "npm run bench:overhead -w @sentinel/server",
    "bench:generate": "npm run bench:generate -w @sentinel/server",
    "verify:figures": "node scripts/verify-figures.mjs",
    "bench:injection": "npm run bench:injection -w @sentinel/server",
    "redteam": "npm run redteam -w @sentinel/server",
    "build:broker": "docker build -f Dockerfile.egress-broker -t volc-egress-broker:local .",
    "verify:egress": "tsx scripts/verify-egress.mjs",
    "diagram": "npx --yes @mermaid-js/mermaid-cli@11 -i docs/architecture-one-page.mmd -o docs/architecture-one-page.png -b white -w 2200",
    "clean": "pnpm -r exec sh -c '(rm data .data workspaces codex-home -r 2> /dev/null || true)'"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
