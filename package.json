{
  "name": "volc-agent-launchpad",
  "version": "1.0.0",
  "private": true,
  "description": "A middleware-free Agent platform starter kit running Codex CLI locally or on Volcengine ECS.",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w @launchpad/server\" \"npm run dev -w @launchpad/web\"",
    "build": "npm run build -w @launchpad/web && npm run build -w @launchpad/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @launchpad/server",
    "check": "npm run typecheck && npm run test && npm run build",
    "poc": "./scripts/start-local-poc.sh",
    "start": "npm run start -w @launchpad/server",
    "doctor": "node scripts/preflight.mjs",
    "preflight": "node scripts/preflight.mjs",
    "demo:offline": "node scripts/demo-offline.mjs",
    "eval:policy": "npm run eval:policy -w @launchpad/server",
    "threat-model": "npm run threat-model -w @launchpad/server",
    "bench:security": "npm run bench:security -w @launchpad/server",
    "bench:store": "npm run bench:store -w @launchpad/server",
    "bench": "npm run bench -w @launchpad/server",
    "bench:overhead": "npm run bench:overhead -w @launchpad/server",
    "redteam": "npm run redteam -w @launchpad/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
