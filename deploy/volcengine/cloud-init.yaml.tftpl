#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git

write_files:
  - path: /opt/agent-sentinel.env
    permissions: "0600"
    encoding: b64
    content: ${runtime_env_b64}

runcmd:
  - curl -fsSL https://get.docker.com -o /opt/get-docker.sh
  - sh /opt/get-docker.sh
  - systemctl enable --now docker
  - mkdir -p /opt/agent-sentinel
  - git clone --depth 1 --branch '${repository_ref}' '${repository_url}' /opt/agent-sentinel/app
  - cp /opt/agent-sentinel.env /opt/agent-sentinel/app/.env.production
  - mkdir -p /opt/agent-sentinel/app/data /opt/agent-sentinel/app/workspaces /opt/agent-sentinel/app/codex-home
  - chown -R 1000:1000 /opt/agent-sentinel/app/data /opt/agent-sentinel/app/workspaces /opt/agent-sentinel/app/codex-home
  - cd /opt/agent-sentinel/app && ./scripts/deploy-existing-ecs.sh .env.production
